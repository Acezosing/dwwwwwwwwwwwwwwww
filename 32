function Library:CreateGradient(Instance, Colors, Rotation)
    local Gradient = Instance:FindFirstChild('UIGradient')
    if not Gradient then
        Gradient = Instance.new('UIGradient')
        Gradient.Parent = Instance
    end
    Gradient.Color = Colors or ColorSequence.new({
        ColorSequenceKeypoint.new(0, Library.AccentColor),
        ColorSequenceKeypoint.new(1, Library.AccentColor2)
    })
    Gradient.Rotation = Rotation or 0
    return Gradient
end

function Library:AddShadow(Instance, Size, Color, Transparency)
    local Shadow = Instance:FindFirstChild('Shadow')
    if not Shadow then
        Shadow = Instance.new('ImageLabel')
        Shadow.Name = 'Shadow'
        Shadow.BackgroundTransparency = 1
        Shadow.Size = UDim2.new(1, 20, 1, 20)
        Shadow.Position = UDim2.new(0, -10, 0, -10)
        Shadow.ZIndex = 0
        Shadow.Image = 'rbxassetid://13160448186' -- Shadow image
        Shadow.ImageColor3 = Color or Color3.fromRGB(0, 0, 0)
        Shadow.ImageTransparency = Transparency or 0.5
        Shadow.Parent = Instance
    end
    return Shadow
end

function Library:RoundCorners(Instance, Radius)
    local UICorner = Instance:FindFirstChild('UICorner')
    if not UICorner then
        UICorner = Instance.new('UICorner')
        UICorner.Parent = Instance
    end
    UICorner.CornerRadius = UDim.new(0, Radius or 8)
    return UICorner
end

